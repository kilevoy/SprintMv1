  "controls": [
    {"id":"climate.country","ui":"Страна","project_input":"climate.country","core1_consumer":"ClimateResolver","type":"enum","unit":null,"default":"RU","required":true,"status":"PROVEN"},
    {"id":"climate.mode","ui":"Режим климатических данных","project_input":"climate.mode","core1_consumer":"ClimateResolver","type":"enum","unit":null,"default":"CITY_LOOKUP","required":true,"status":"PROVEN"},
    {"id":"climate.city","ui":"Населённый пункт","project_input":"climate.city","core1_consumer":"exact city climate lookup","type":"string","unit":null,"default":"Роза","required":true,"status":"PROVEN_EXACT_KEYS_ONLY"},
    {"id":"climate.manual.snow","ui":"Снеговой район / нагрузка","project_input":"climate.snow_region, climate.snow_load","core1_consumer":"manual climate","type":"string+number","unit":"kN/m² for load","default":null,"required":true,"status":"PROVEN_MAPPING"},
    {"id":"climate.manual.wind","ui":"Ветровой район / нагрузка","project_input":"climate.wind_region, climate.wind_load","core1_consumer":"manual climate","type":"string+number","unit":"kN/m² for load","default":null,"required":true,"status":"PROVEN_MAPPING"},
    {"id":"geometry.span","ui":"Пролёт, м","project_input":"geometry.span_m","core1_consumer":"design family and frame/purlin geometry","type":"number","unit":"m","default":12,"required":true,"status":"PARTIAL_UI_CANONICAL_OPTIONS_ONLY","notes":"Core1 preserves literal positive spans; UI exposes only 9/12/15/18/21/24."},
    {"id":"geometry.length","ui":"Длина, м","project_input":"geometry.building_length_m","core1_consumer":"frame count, purlin, summary","type":"number","unit":"m","default":18,"required":true,"status":"PROVEN_MAPPING"},
    {"id":"geometry.height","ui":"Высота, м","project_input":"geometry.building_height_m","core1_consumer":"frame profile selector","type":"number","unit":"m","default":3,"required":true,"status":"PROVEN_WITH_DOMAIN_VALIDATION"},
    {"id":"geometry.responsibility","ui":"Ответственность","project_input":"geometry.responsibility_factor","core1_consumer":"frame/purlin branches","type":"enum","unit":null,"default":0.8,"required":true,"status":"PROVEN"},
    {"id":"geometry.frame_step_override","ui":"Задать шаг рам вручную / Шаг рам","project_input":"geometry.frame_step_override_m","core1_consumer":"effective frame step (D9 over D8)","type":"number|null","unit":"m","default":null,"required":false,"status":"PARTIAL_MANUAL_PARITY"},
    {"id":"envelope.roof_covering","ui":"Покрытие","project_input":"envelope.roof_covering","core1_consumer":"purlin selection","type":"exact enum","unit":null,"default":"С-П 200","required":true,"status":"PROVEN"},
    {"id":"envelope.roof_deck_grade","ui":"Марка настила","project_input":"envelope.roof_deck_grade","core1_consumer":"purlin deck limit","type":"exact enum","unit":null,"default":"С44-1000-0,7","required":true,"status":"PROVEN"},
    {"id":"envelope.wall_system","ui":"Стены","project_input":"envelope.wall_system","core1_consumer":null,"type":"string","unit":null,"default":"Сэндвич-панель 200 мм","required":false,"status":"CORE2_ONLY"},
    {"id":"special.snow_retention","ui":"Снегозадержание","project_input":"special_conditions.snow_retention_purlin","core1_consumer":"purlin line/weight","type":"enum","unit":null,"default":"нет","required":true,"status":"PROVEN"},
    {"id":"special.enclosure_purlin","ui":"Прогон ограждения","project_input":"special_conditions.enclosure_purlin","core1_consumer":"purlin line/weight","type":"enum","unit":null,"default":"нет","required":true,"status":"PROVEN_CORE1_PURLIN_FLAG"},
    {"id":"special.horizontal_bracing","ui":"Специальный горизонтальный связевой сценарий","project_input":"special_conditions.horizontal_bracing_override","core1_consumer":"secondary steel","type":"+|null","unit":null,"default":null,"required":false,"status":"PROVEN_TRANSPORT"},
    {"id":"openings.gate","ui":"Ворота: ширина, высота, количество","project_input":"openings[] gate","core1_consumer":"gates_le_6m_count / gates_gt_6m_count","type":"mm+integer","unit":"mm","default":"4000x4200x1","required":false,"status":"PARTIAL_GATE_POLICY_UNVERIFIED","diagnostic":"CORE1_GATE_CLASSIFICATION_UNVERIFIED"},
    {"id":"openings.door","ui":"Двери: ширина, высота, количество","project_input":"openings[] door","core1_consumer":"doors_count","type":"mm+integer","unit":"mm","default":"900x2100x1","required":false,"status":"PARTIAL_COUNT_ONLY"},
    {"id":"openings.window","ui":"Окна: размеры, количество, тип, остекление","project_input":"openings[] window","core1_consumer":"legacy window projection and enhanced window girt module","type":"structured","unit":"mm/count","default":"1200x1500x1","required":false,"status":"PARTIAL_COMPATIBLE_GROUPS_ONLY","diagnostic":"CORE1_OPENINGS_NOT_REPRESENTABLE"},
    {"id":"openings.strip_window","ui":"Ленточное окно","project_input":"openings[] strip_window","core1_consumer":"window_strip_length_m","type":"structured","unit":"mm/count","default":"1500x6000x1","required":false,"status":"PARTIAL_ONE_GROUP_ONLY"},
    {"id":"other.selection_mode","ui":"Режим подбора","project_input":"other.selection_mode","core1_consumer":"Core1 selection input","type":"enum","unit":null,"default":"стандарт","required":true,"status":"PROVEN_TRANSPORT"},
    {"id":"other.roof_type","ui":"Тип кровли","project_input":"other.building_roof_type","core1_consumer":"Core1 input","type":"enum","unit":null,"default":"двускатное","required":true,"status":"PROVEN_TRANSPORT"},
    {"id":"other.purlin_overrides","ui":"Ограничения шага прогонов","project_input":"other.purlin_max_step_override_mm, other.purlin_min_step_mm","core1_consumer":"purlin selection","type":"number|null","unit":"mm","default":"null/0","required":false,"status":"PARTIAL_DOMAIN"},
    {"id":"other.terrain","ui":"Тип местности","project_input":"other.terrain_type","core1_consumer":"wind/purlin-related branches","type":"enum","unit":null,"default":"В","required":true,"status":"PROVEN_TRANSPORT"},
    {"id":"other.window_parameters","ui":"Коэффициент оконной схемы / предел использования","project_input":"other.window_scheme_factor, other.window_utilization_limit","core1_consumer":"enhanced window module","type":"number","unit":null,"default":"1.0/0.85","required":false,"status":"PARTIAL_ENHANCED_MODULE"}
  ],
